# ---------------------------------------------------------------
# AnkiLM Frontend – Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die .env-Datei wird NICHT committet.
#
# Für Vercel: Variablen im Vercel-Dashboard unter
# Project Settings → Environment Variables eintragen.
# ---------------------------------------------------------------

# URL des gehosteten Backends (Deno Orchestrator)
# Lokal: http://localhost:3000 (oder den Port des Backend-Containers)
# Gehostet: https://api.deinedomain.com
VITE_BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# Google Cloud Storage (wird in Phase 5 benötigt)
# Für das Frontend: öffentliche Bucket-URL zum Laden von Outputs
# ---------------------------------------------------------------
# VITE_GCS_BUCKET_URL=https://storage.googleapis.com/anki-lm-outputs
