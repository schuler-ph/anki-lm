# Dify shared secret key — generate with: openssl rand -hex 32
SECRET_KEY=replace-with-32-byte-hex

# PostgreSQL
POSTGRES_USER=dify
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=dify
DB_HOST=dify-db
DB_PORT=5432

# Redis
REDIS_HOST=dify-redis
REDIS_PORT=6379

# Weaviate
WEAVIATE_HOST=dify-weaviate
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=replace-with-strong-api-key

# Sandbox
SANDBOX_API_KEY=replace-with-sandbox-key

# Storage (local in container)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/api/storage

# SSRF proxy
SSRF_PROXY_HTTP_URL=http://ssrf-proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf-proxy:3128

# Console URL — update after you know your domain/IP
CONSOLE_API_URL=https://dify.yourdomain.com
CONSOLE_WEB_URL=https://dify.yourdomain.com
SERVICE_API_URL=https://dify.yourdomain.com
APP_API_URL=https://dify.yourdomain.com
APP_WEB_URL=https://dify.yourdomain.com
FILES_URL=https://dify.yourdomain.com
