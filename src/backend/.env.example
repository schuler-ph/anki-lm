# ---------------------------------------------------------------
# AnkiLM Backend – Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die .env-Datei wird NICHT committet (siehe .gitignore).
# ---------------------------------------------------------------

# OpenAI API Key (für Whisper-Transkription)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Dify Workflow API Key
# Im Dify-Dashboard unter: App → API → API Key
DIFY_API_KEY=app-...

# Dify API URL
# Lokal: http://localhost:8099
# Gehostet (Hetzner/RPi): https://dify.deinedomain.com
DIFY_API_URL=http://localhost:8099

# Lokaler Pfad zum Ordner mit den Vorlesungs-Dateien
# Enthält Unterordner pro Fach (eai/, lar/, iid/, ...)
# Wird in Docker durch ein Volume ersetzt (dann z.B. /app/data/lectures)
LECTURE_ROOT=/Users/dein-name/path/to/lectures

# ---------------------------------------------------------------
# Notion Integration (optional / derzeit nicht aktiv genutzt)
# https://www.notion.so/my-integrations
# ---------------------------------------------------------------
NOTION_API_KEY=ntn_...
NOTION_GTD_DB_ID=...

# ---------------------------------------------------------------
# Google Cloud Storage + Cloud Run backend API (Phase 4+)
# ---------------------------------------------------------------
GCP_PROJECT_ID=anki-lm
GCS_BUCKET=ankilm-files
GOOGLE_APPLICATION_CREDENTIALS=/absoluter/pfad/zu/infra/gcp/sa-key.json
