# ---------------------------------------------------------------
# AnkiLM Backend – Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die .env-Datei wird NICHT committet (siehe .gitignore).
# ---------------------------------------------------------------

# OpenAI API Key (für Whisper-Transkription)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Dify Workflow API Key
# Im Dify-Dashboard unter: App → API → API Key
DIFY_API_KEY=app-...

# Dify API URL
# Lokal: http://localhost:8099
# Gehostet (Hetzner/RPi): https://dify.deinedomain.com
DIFY_API_URL=http://localhost:8099

# Lokaler Pfad zum Ordner mit den Vorlesungs-Dateien
# Enthält Unterordner pro Fach (eai/, lar/, iid/, ...)
# Wird in Docker durch ein Volume ersetzt (dann z.B. /app/data/lectures)
LECTURE_ROOT=/Users/dein-name/path/to/lectures

# File-Server URL (solange fileAcceptor.ts noch in Verwendung ist)
# Lokal: http://localhost:8019
# In Docker (Dify spricht Backend an): http://host.docker.internal:8019
# → wird entfernt, sobald Cloud Storage integriert ist (Phase 5)
FILE_SERVER_URL=http://localhost:8019

# URL des File-Servers aus Sicht von Dify (läuft in Docker → andere Adresse)
# Lokal mit Dify in Docker: http://host.docker.internal:8019
# Gehostet: http://backend:8019 (Docker-Service-Name)
DIFY_FILE_SERVER_URL=http://host.docker.internal:8019

# ---------------------------------------------------------------
# Notion Integration (optional / derzeit nicht aktiv genutzt)
# https://www.notion.so/my-integrations
# ---------------------------------------------------------------
NOTION_API_KEY=ntn_...
NOTION_GTD_DB_ID=...

# ---------------------------------------------------------------
# Google Cloud Storage (wird in Phase 5 benötigt)
# ---------------------------------------------------------------
# GCS_BUCKET_NAME=anki-lm-outputs
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcs-key.json
